# Path configuration - REQUIRED
# Set the absolute path to the repository root directory
REPO_ROOT=C:\path\to\tranym

# Set the absolute path to the photon build directory
PHOTON_ROOT=C:\path\to\tranym\photon

# Set the absolute path to the Android web assets directory
WEB_ASSETS=C:\path\to\tranym\mobile-app\android\app\src\main\assets\photon

# Optional: Enable cleartext traffic for development
TRANYM_ALLOW_CLEARTEXT=true

# Use Photon Vite dev server instead of packaging static assets.
# For an Android emulator, 10.0.2.2 reaches the development computer.
PHOTON_MODE=dev
PHOTON_DEV_URL=http://10.0.2.2:5173
PHOTON_DEV_HOST=0.0.0.0
PHOTON_DEV_PORT=5173
